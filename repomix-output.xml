MERGE dbo.Products AS target
USING @Products AS source
ON target.Name = source.Name
WHEN MATCHED THEN
    UPDATE SET
        Price = source.Price,
        Stock = source.Stock,
        CategoryId = source.CategoryId,
        Description = source.Description,
