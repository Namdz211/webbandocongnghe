.ecommerce-footer .social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  background: #2a2a2a;
  border-radius: 50%;
  color: #ccc;
  text-decoration: none;
  transition: all 0.3s ease;
  border: 1px solid #444;
}

.ecommerce-footer .social-link:hover {
  color: #fff;
  transform: translateY(-3px);
}

.ecommerce-footer .social-link.facebook:hover {
  background: #1877f2;
  border-color: #1877f2;
}

.ecommerce-footer .social-link.instagram:hover {
  background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
  border-color: #e6683c;
}

.ecommerce-footer .social-link.twitter:hover {
  background: #1da1f2;
  border-color: #1da1f2;
}

.ecommerce-footer .social-link.youtube:hover {
  background: #ff0000;
  border-color: #ff0000;
}

.ecommerce-footer .social-link.tiktok:hover {
  background: #000;
  border-color: #000;
}

.ecommerce-footer .social-link.zalo:hover {
  background: #0068ff;
  border-color: #0068ff;
}

.ecommerce-footer .social-link.messenger:hover {
  background: #0084ff;
  border-color: #0084ff;
}

/* App Download Section */
.ecommerce-footer .footer-app h4 {
  color: #fff;
  font-size: 16px;
  margin-bottom: 15px;
  font-weight: 500;
}

.ecommerce-footer .app-buttons {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.ecommerce-footer .app-button {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  background: #2a2a2a;
  border: 1px solid #444;
  border-radius: 8px;
  color: #fff;
  text-decoration: none;
  font-size: 13px;
  transition: all 0.3s ease;
}

.ecommerce-footer .app-button:hover {
  background: #333;
  border-color: #D10024;
  color: #fff;
  transform: translateY(-2px);
}

/* Payment Methods & Trust Badges Section */
.ecommerce-footer .footer-payment-section {
  background: #222;
  padding: 30px 0;
  border-bottom: 1px solid #333;
}

.ecommerce-footer .footer-payment h4,
.ecommerce-footer .footer-trust h4 {
  color: #fff;
  font-size: 16px;
  margin-bottom: 15px;
  font-weight: 500;
}

.ecommerce-footer .payment-methods {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
}

.ecommerce-footer .payment-method {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: #1a1a1a;
  border: 1px solid #444;
  border-radius: 6px;
  color: #ccc;
  font-size: 13px;
  transition: all 0.3s ease;
}

.ecommerce-footer .payment-method:hover {
  border-color: #D10024;
  color: #fff;
}

.ecommerce-footer .payment-method.paypal {
  background: #003087;
  color: #fff;
  border-color: #003087;
}

.ecommerce-footer .trust-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
}

.ecommerce-footer .trust-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: #1a1a1a;
  border: 1px solid #444;
  border-radius: 6px;
  color: #ccc;
  font-size: 13px;
  transition: all 0.3s ease;
}

.ecommerce-footer .trust-badge:hover {
  border-color: #4CAF50;
  color: #4CAF50;
}

/* Bottom Footer */
.ecommerce-footer .footer-bottom {
  background: #111;
  padding: 20px 0;
}

.ecommerce-footer .legal-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

.ecommerce-footer .legal-links li {
  position: relative;
}

.ecommerce-footer .legal-links li:not(:last-child)::after {
  content: '|';
  position: absolute;
  right: -12px;
  color: #666;
}

.ecommerce-footer .legal-links a {
  color: #ccc;
  text-decoration: none;
  font-size: 13px;
  transition: color 0.3s ease;
}

.ecommerce-footer .legal-links a:hover {
  color: #D10024;
}

.ecommerce-footer .footer-copyright {
  text-align: right;
}

.ecommerce-footer .footer-copyright p {
  color: #ccc;
  margin: 0;
  font-size: 13px;
  line-height: 1.4;
}

.ecommerce-footer .powered-by {
  color: #888;
  font-size: 12px;
}

/* Responsive Design */
@media (max-width: 768px) {
  .ecommerce-footer .section {
    padding: 40px 0 30px;
  }
  
  .ecommerce-footer .footer-title {
    font-size: 16px;
    margin-bottom: 15px;
  }
  
  .ecommerce-footer .footer-description {
    font-size: 13px;
  }
  
  .ecommerce-footer .footer-links a,
  .ecommerce-footer .footer-contact li {
    font-size: 13px;
  }
  
  .ecommerce-footer .social-links {
    justify-content: center;
  }
  
  .ecommerce-footer .app-buttons {
    justify-content: center;
  }
  
  .ecommerce-footer .payment-methods,
  .ecommerce-footer .trust-badges {
    justify-content: center;
  }
  
  .ecommerce-footer .footer-copyright {
    text-align: center;
    margin-top: 20px;
  }
  
  .ecommerce-footer .legal-links {
    justify-content: center;
    margin-bottom: 15px;
  }
  
  .ecommerce-footer .legal-links li:not(:last-child)::after {
    display: none;
  }
}

@media (max-width: 480px) {
  .ecommerce-footer .section {
    padding: 30px 0 20px;
  }
  
  .ecommerce-footer .footer-payment-section {
    padding: 20px 0;
  }
  
  .ecommerce-footer .footer-bottom {
    padding: 15px 0;
  }
  
  .ecommerce-footer .payment-methods,
  .ecommerce-footer .trust-badges {
    gap: 10px;
  }
  
  .ecommerce-footer .payment-method,
  .ecommerce-footer .trust-badge {
    font-size: 12px;
    padding: 6px 10px;
  }
  
  .ecommerce-footer .newsletter-input-group {
    flex-direction: column;
    border-radius: 8px;
  }
  
  .ecommerce-footer .newsletter-input {
    border-radius: 8px 8px 0 0;
  }
  
  .ecommerce-footer .newsletter-btn {
    border-radius: 0 0 8px 8px;
  }
}

/* Animation and Transitions */
.ecommerce-footer .footer-links a {
  position: relative;
}

.ecommerce-footer .footer-links a::before {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 0;
  height: 1px;
  background: #D10024;
  transition: width 0.3s ease;
}

.ecommerce-footer .footer-links a:hover::before {
  width: 100%;
}

/* Accessibility */
.ecommerce-footer .social-link:focus,
.ecommerce-footer .app-button:focus,
.ecommerce-footer .newsletter-btn:focus {
  outline: 2px solid #D10024;
  outline-offset: 2px;
}

/* Print Styles */
@media print {
  .ecommerce-footer {
    background: #fff;
    color: #000;
  }
  
  .ecommerce-footer .footer-newsletter,
  .ecommerce-footer .footer-social,
  .ecommerce-footer .footer-app {
    display: none;
  }
}
</file>

<file path="BaseCore/WebClient/src/styles/global.css">
:root {
  color: #2b2d42;
  background: #f5f6fa;
  font-family: 'Montserrat', sans-serif;
