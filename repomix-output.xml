  padding: 0;
}

.header-link-button:hover,
.header-link-button:focus,
.header-links a:hover,
.footer-links a:hover,
.section-link:hover {
  color: #d10024;
}

.account-menu-wrap {
  position: relative;
}

.account-menu-trigger {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
}

.account-menu {
