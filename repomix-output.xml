    var obsoleteCategories = db.Categories
        .Where(category => obsoleteCategoryNames.Contains(category.Name))
        .ToList()
        .Where(category => !usedCategoryIds.Contains(category.Id));

    db.Categories.RemoveRange(obsoleteCategories);
    db.SaveChanges();
