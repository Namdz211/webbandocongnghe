  border-radius: 6px;
  background: transparent;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  text-align: left;
  cursor: pointer;
}

.account-menu-item:hover,
.account-menu-item:focus {
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  outline: none;
}

.header-search .search-btn {
  border: 0;
}

/* Keep the "Tim kiem" button on the same row as the search inputs */
.header-search form {
  display: flex;
