                >
                  {loading ? 'Signing in...' : 'Sign In'}
                </button>
              </div>
            </div>

            <p className="mb-0 mt-3 text-center text-muted">
              <small>Demo: admin / admin123</small>
            </p>
          </div>
        </div>
      </div>
    </div>
  );
};

